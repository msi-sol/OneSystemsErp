# Prisma 6 and Next.js load this file after it is copied to .env in the project root.
# Both apps use MySQL and the single schema at prisma/schema.prisma.
# URL-encode special characters in credentials. Use your local MySQL account here.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/onesystemserp"
# The CLI uses DIRECT_URL; it must point to the same MySQL database.
# Production uses the separately configured, restricted migrator account with verified TLS.
DIRECT_URL="mysql://user:password@127.0.0.1:3306/onesystemserp"

AUTH_SECRET="your_auth_secret_here"

# Google Gemini API Key for Biometrics AI parsing
GEMINI_API_KEY="your_gemini_api_key_here"

NEXT_PUBLIC_APP_URL="https://onesystemserp.com"

# Google Maps API Key (Places, Maps JavaScript, Geocoding APIs must be enabled)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# Password of the local test accounts, read by scripts/, scratch/ and tests/e2e. Local use only.
LOCAL_TEST_PASSWORD=""
# Password those scripts rotate a local test account to.
LOCAL_TEST_NEW_PASSWORD=""

# Development saves files privately under .runtime/ and never uploads to S3.
# Set these in the production environment only; EC2 uses its existing IAM role.
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET_NAME="your-private-production-upload-bucket"
# S3_BUCKET_NAME="your-private-production-upload-bucket"
# No static AWS access keys are required on EC2.
