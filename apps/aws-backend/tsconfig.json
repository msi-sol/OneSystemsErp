{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDir": "../..",
    "baseUrl": "../..",
    "paths": { "@/*": ["src/*"] },
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"]
}
