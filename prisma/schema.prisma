model ProjectSchedule {
  id                 String    @id @default(cuid())
  projectId          String
  name               String
  description        String? @db.LongText
  baselineStartDate  DateTime?
  baselineFinishDate DateTime?
  currentStartDate   DateTime?
  currentFinishDate  DateTime?
  actualStartDate    DateTime?
  actualFinishDate   DateTime?
  status             String    @default("DRAFT") // DRAFT, BASELINE, REVISED, COMPLETED
  calendarDays       Int       @default(0)
  workingDays        Int       @default(0)
  holidays           String? // JSON string of dates
  workDaysConfig     String? @db.LongText // JSON e.g. ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]

  lockedBOQVersionId     String?
  lockedBOQChecksum      String?
  baselineRevision       Int       @default(0)
  awardedContractAmount  Decimal   @default(0)
  scheduledAmount        Decimal   @default(0)
  differenceAmount       Decimal   @default(0)
  generatedBy            String?
  approvedBy             String?
  generatedAt            DateTime?
  approvedAt             DateTime?
  generationRulesVersion String?
  validationMetrics      String?   @db.LongText
  feasibilityFlags       String?   @db.LongText

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities      ScheduleActivity[]
  wbsNodes        ScheduleWBS[]
  dependencies    ScheduleDependency[]
  milestones      ScheduleMilestone[]
  progressUpdates ScheduleProgressUpdate[]
  delayRecords    ScheduleDelayRecord[]
  recoveryPlans   ScheduleRecoveryPlan[]
  revisions       ScheduleRevisionRequest[]
  boqAllocations  ScheduleBOQAllocation[]   @relation("ScheduleBOQAllocations")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // --- Phase 3 Additions ---
  workflowStatus ProjectScheduleWorkflowStatus @default(AI_GENERATED_DRAFT)
  reviewRound    Int                           @default(1)
  revisionNumber Int?
  revisionCode   String?

  parentScheduleId   String?
  previousBaselineId String?

  projectStartDate      DateTime?
  projectCompletionDate DateTime?

  openAiModelIdentifier   String?
  promptVersion           String?
  schedulingEngineVersion String?
  validationRulesVersion  String?

  generatedById String?
  activatedById String?
  activatedAt   DateTime?
  baselineCode  String?

  activationSnapshotHash String?
  rowVersion             Int     @default(1)

  parentSchedule ProjectSchedule?  @relation("ScheduleRevisionParent", fields: [parentScheduleId], references: [id], onDelete: Restrict)
  childRevisions ProjectSchedule[] @relation("ScheduleRevisionParent")

  previousBaseline     ProjectSchedule?  @relation("PreviousApprovedBaseline", fields: [previousBaselineId], references: [id], onDelete: Restrict)
  supersedingBaselines ProjectSchedule[] @relation("PreviousApprovedBaseline")

  generatedByUser User? @relation("ScheduleGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  activatedBy     User? @relation("ScheduleActivatedBy", fields: [activatedById], references: [id], onDelete: Restrict)

  approvals            ScheduleApproval[]
  reviewComments       ScheduleReviewComment[]
  baselineActivations  BaselineActivation[]
  financialDataWaivers FinancialDataWaiver[]
  revisionReasons      ScheduleRevisionReason[]
  workflowTransitions  ScheduleWorkflowTransition[]

  @@unique([id, projectId])
  @@unique([projectId, revisionNumber])
  @@unique([projectId, revisionCode])
  @@index([projectId, workflowStatus])
  @@index([parentScheduleId])
  @@index([previousBaselineId])
  @@index([lockedBOQVersionId])
}

