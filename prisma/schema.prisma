// ==================================================
// PHASE 3 BASELINE REVIEW & APPROVAL ENUMS
// ==================================================

enum ProjectScheduleWorkflowStatus {
  AI_GENERATED_DRAFT
  INVALID_GENERATED_DRAFT
  READY_FOR_REVIEW

  UNDER_TECHNICAL_REVIEW
  TECHNICAL_REVISIONS_REQUIRED
  TECHNICALLY_APPROVED

  UNDER_CONTRACT_REVIEW
  CONTRACT_REVISIONS_REQUIRED
  CONTRACT_APPROVED

  UNDER_FINANCE_REVIEW
  FINANCE_REVISIONS_REQUIRED
  FINANCE_APPROVED

  PENDING_BASELINE_APPROVAL

  ACTIVE_BASELINE
  SUPERSEDED_BASELINE
  ARCHIVED_BASELINE

  REJECTED
}

enum ScheduleApprovalStage {
  TECHNICAL
  CONTRACT
  FINANCE
  FINAL_ACTIVATION
}

enum ScheduleApprovalDecision {
  APPROVE
  RETURN_FOR_REVISION
  REJECT
  REQUEST_CLARIFICATION
}

enum ScheduleCommentType {
  TECHNICAL
  FINANCIAL
  BOQ_ALLOCATION
  SEQUENCE
  DURATION
  PRODUCTIVITY
  CREW
  WORK_FRONT
  CPM
  CONTRACT_DATE
  COMMISSIONING
  CLOSEOUT
}

enum ScheduleCommentStatus {
  OPEN
  RESOLVED
  CLOSED
  CANCELLED
}

enum FinancialWaiverStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

enum ScheduleRevisionType {
  AI_REGENERATION
  TECHNICAL_CORRECTION
  CONTRACT_CORRECTION
  FINANCIAL_CORRECTION
  RECOVERY
  VARIATION_ORDER
  TIME_EXTENSION
  SUSPENSION_RESUMPTION
  METHODOLOGY_CHANGE
  RESOURCE_CHANGE
  CLIENT_INSTRUCTION
}

// ==================================================
// PHASE 3 BASELINE REVIEW & APPROVAL MODELS
// ==================================================

model ScheduleApproval {
  id                   String                   @id @default(cuid())
  projectId            String
  scheduleId           String
  reviewRound          Int
  revisionCode         String?
  approvalStage        ScheduleApprovalStage
  decision             ScheduleApprovalDecision
  reviewerId           String
  reviewerNameSnapshot String
  reviewerRoleSnapshot String
  comments             String?                  @db.LongText
  validationSnapshot   Json?
  snapshotVersion      String
  scheduleSnapshotHash String?
  lockedBOQChecksum    String?
  decidedAt            DateTime                 @default(now())
  createdAt            DateTime                 @default(now())
  idempotencyKey       String?                  @unique
  requestId            String?

  schedule ProjectSchedule @relation(fields: [scheduleId, projectId], references: [id, projectId], onDelete: Restrict)
  reviewer User            @relation("ScheduleApprovalActor", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([projectId, scheduleId])
  @@index([scheduleId, reviewRound])
  @@index([scheduleId, approvalStage])
  @@index([reviewerId])
}

model ScheduleReviewComment {
  id                    String                @id @default(cuid())
  projectId             String
  scheduleId            String
  reviewRound           Int
  activityId            String?
  phaseId               String?
  commentType           ScheduleCommentType
  comment               String                @db.LongText
  status                ScheduleCommentStatus @default(OPEN)
  createdById           String
  createdByNameSnapshot String
  createdByRoleSnapshot String
  resolvedById          String?
  resolutionComment     String?               @db.LongText
  createdAt             DateTime              @default(now())
  resolvedAt            DateTime?

  schedule   ProjectSchedule @relation(fields: [scheduleId, projectId], references: [id, projectId], onDelete: Restrict)
  createdBy  User            @relation("ScheduleCommentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedBy User?           @relation("ScheduleCommentResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
}

model BaselineActivation {
  id                      String    @id @default(cuid())
  projectId               String
  scheduleId              String
  reviewRound             Int
  revisionCode            String
  previousBaselineId      String?
  validationSnapshot      Json
  snapshotVersion         String
  scheduleSnapshotHash    String
  lockedBOQChecksum       String?
  activatedById           String
  activatedByNameSnapshot String
  activatedByRoleSnapshot String
  activatedAt             DateTime  @default(now())
  createdAt               DateTime  @default(now())
  idempotencyKey          String?   @unique
  requestId               String?
  isAuthoritative         Boolean   @default(false)
  invalidatedAt           DateTime?
  invalidationReason      String? @db.LongText

  schedule    ProjectSchedule @relation(fields: [scheduleId, projectId], references: [id, projectId], onDelete: Restrict)
  activatedBy User            @relation("BaselineActivationActor", fields: [activatedById], references: [id], onDelete: Restrict)
}

model FinancialDataWaiver {
  id                      String                @id @default(cuid())
  projectId               String
  scheduleId              String
  reason                  String                @db.LongText
  affectedFields          Json
  normalizationMethod     String
  migrationDeadline       DateTime?
  requestedById           String
  requestedByNameSnapshot String
  requestedByRoleSnapshot String
  approvedById            String?
  approvedByNameSnapshot  String?
  approvedByRoleSnapshot  String?
  approvedAt              DateTime?
  expiresAt               DateTime?
  status                  FinancialWaiverStatus @default(PENDING)
  createdAt               DateTime              @default(now())
  revokedAt               DateTime?
  revocationReason        String?               @db.LongText

  schedule    ProjectSchedule @relation(fields: [scheduleId, projectId], references: [id, projectId], onDelete: Restrict)
  requestedBy User            @relation("FinancialWaiverRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?           @relation("FinancialWaiverApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
}

model ScheduleRevisionReason {
  id                    String               @id @default(cuid())
  projectId             String
  scheduleId            String
  parentScheduleId      String?
  revisionType          ScheduleRevisionType
  reason                String               @db.LongText
  supportingReference   String? @db.LongText
  createdById           String
  createdByNameSnapshot String
  createdByRoleSnapshot String
  createdAt             DateTime             @default(now())

  schedule  ProjectSchedule @relation(fields: [scheduleId, projectId], references: [id, projectId], onDelete: Restrict)
  createdBy User            @relation("ScheduleRevisionReasonCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
}

enum ScheduleWorkflowAction {
  SUBMIT_DRAFT_FOR_REVIEW
  START_TECHNICAL_REVIEW
}

model ScheduleWorkflowTransition {
  id                  String                        @id @default(cuid())
  projectId           String
  scheduleId          String
  action              ScheduleWorkflowAction
  fromStatus          ProjectScheduleWorkflowStatus
  toStatus            ProjectScheduleWorkflowStatus
  actorUserId         String
  actorSessionVersion Int
  expectedRowVersion  Int
  resultingRowVersion Int
  idempotencyKeyHash  String
  correlationId       String?
  occurredAt          DateTime                      @default(now())
  metadata            String?                       @db.LongText

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  schedule ProjectSchedule @relation(fields: [scheduleId, projectId], references: [id, projectId], onDelete: Restrict)
  actor    User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, action, idempotencyKeyHash])
  @@index([scheduleId, occurredAt])
  @@index([projectId, action, occurredAt])
  @@index([actorUserId, occurredAt])
}

model PasswordRecoveryToken {
  id                     String    @id @default(uuid())
  userId                 String
  tokenHash              String    @unique
  purpose                String    @default("PASSWORD_RESET")
  createdAt              DateTime  @default(now())
  expiresAt              DateTime
  consumedAt             DateTime?
  revokedAt              DateTime?
  requestedIpHash        String?
  requestedUserAgentHash String?
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([purpose, expiresAt])
  @@index([tokenHash, consumedAt, revokedAt])
}

model PasswordRecoveryRateLimit {
  id             String    @id @default(uuid())
  identifierHash String
  attempts       Int       @default(1)
  lastAttemptAt  DateTime  @default(now())
  blockedUntil   DateTime?

  @@index([identifierHash])
}
